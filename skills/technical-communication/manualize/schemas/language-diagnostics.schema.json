{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["file", "profile", "violations"],
  "properties": {
    "file": {"type": "string"},
    "profile": {"enum": ["strict", "standard"]},
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "severity", "line", "sentence", "issue", "fix"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^MTE-[A-Z]+-[0-9]{3}$"},
          "severity": {"enum": ["error", "warning"]},
          "line": {"type": "integer", "minimum": 1},
          "sentence": {"type": "string"},
          "issue": {"type": "string"},
          "fix": {"type": "string"}
        }
      }
    }
  }
}
