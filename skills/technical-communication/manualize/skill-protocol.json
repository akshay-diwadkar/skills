{
  "protocol_version": "1.0",
  "skill": "manualize",
  "minimum_python": "3.11",
  "run_dir_policy": "outside_skill_and_repo",
  "classification": {
    "phase": "classification_review",
    "artifact": "classification",
    "required_inputs": ["request_file"],
    "controlled_inputs": ["operation", "profile"],
    "override_input": "classification_override",
    "argv": ["{python}", "{skill_dir}/scripts/classify_workflow.py", "--kind", "manualize", "--repo-root", "{repo_root}", "--source", "{input.request_file}"],
    "repeat": []
  },
  "requirements": [
    {"distribution": "jsonschema", "specifier": ">=4.0"}
  ],
  "inputs": [
    {"name": "request_file", "kind": "path", "required": true, "repeatable": false, "description": "Trusted manualization request file.", "choices": []},
    {"name": "operation", "kind": "choice", "required": true, "repeatable": false, "description": "Authorized write or read-only audit operation.", "choices": ["write", "audit"]},
    {"name": "profile", "kind": "choice", "required": true, "repeatable": false, "description": "Controlled-language profile.", "choices": ["strict", "standard"]},
    {"name": "manual", "kind": "path", "required": true, "repeatable": false, "description": "Manual Markdown path.", "choices": []},
    {"name": "bundle", "kind": "path", "required": true, "repeatable": false, "description": "Manual bundle JSON path.", "choices": []},
    {"name": "glossary", "kind": "path", "required": true, "repeatable": false, "description": "Glossary JSON path.", "choices": []},
    {"name": "classification_override", "kind": "path", "required": false, "repeatable": false, "description": "Hash-bound contrary classification evidence.", "choices": []}
  ],
  "artifacts": [
    {"name": "classification", "path": "classification.json", "media_type": "application/json"},
    {"name": "audit", "path": "manual-audit.json", "media_type": "application/json"}
  ],
  "phases": {
    "classification_review": {
      "status": "ready",
      "next_action": "apply_deterministic_classification",
      "next_command": "apply_classification",
      "required_reads": ["{run_dir}/classification.json"],
      "result_artifact": "classification",
      "allowed_writes": [],
      "forbidden_actions": ["write_installed_skill", "write_target_repository", "override_without_contrary_evidence"]
    },
    "drafting": {
      "status": "in_progress",
      "next_action": "validate_manual_and_bundle",
      "next_command": "validate",
      "required_reads": ["{skill_dir}/references/mte-1.md", "{skill_dir}/references/manual-bundle.md", "{skill_dir}/references/source-grounding.md", "{input.manual}", "{input.bundle}", "{input.glossary}"],
      "allowed_writes": ["{input.manual}", "{input.bundle}"],
      "forbidden_actions": ["write_installed_skill", "invent_source_facts"]
    },
    "validated": {
      "status": "ready",
      "next_action": "finalize_manual",
      "next_command": "finalize",
      "required_reads": ["{input.manual}", "{input.bundle}"],
      "allowed_writes": ["{input.bundle}"],
      "forbidden_actions": ["write_installed_skill", "edit_validated_manual"]
    },
    "auditing": {
      "status": "in_progress",
      "next_action": "run_read_only_audit",
      "next_command": "audit_report",
      "required_reads": ["{skill_dir}/references/mte-1.md", "{skill_dir}/references/audit-report.md", "{input.manual}", "{input.bundle}", "{input.glossary}"],
      "allowed_writes": ["{run_dir}/manual-audit.json"],
      "forbidden_actions": ["write_installed_skill", "write_target_repository", "modify_manual", "modify_bundle", "modify_glossary", "remediate_without_authorization"]
    },
    "complete": {
      "status": "complete",
      "next_action": null,
      "next_command": null,
      "required_reads": [],
      "conditional_reads": [
        {"input": "operation", "values": ["write"], "paths": ["{input.manual}", "{input.bundle}"]},
        {"input": "operation", "values": ["audit"], "paths": ["{run_dir}/manual-audit.json"]}
      ],
      "allowed_writes": [],
      "forbidden_actions": ["write_installed_skill", "modify_finalized_artifact", "remediate_audit_without_authorization"]
    }
  },
  "commands": {
    "start": [
      {"when": {"operation": ["write"]}, "allowed_phases": ["drafting"], "success_phase": "drafting", "steps": []},
      {"when": {"operation": ["audit"]}, "allowed_phases": ["auditing"], "success_phase": "auditing", "steps": []}
    ],
    "validate": {
      "allowed_phases": ["drafting"],
      "success_phase": "validated",
      "steps": [
        {"argv": ["{python}", "{skill_dir}/scripts/check_manual_language.py", "--profile", "{input.profile}", "--glossary", "{input.glossary}", "{input.manual}"], "repeat": [], "capture_stdout": null, "diagnostics_json": true, "failure": "blocked"},
        {"argv": ["{python}", "{skill_dir}/scripts/check_manual.py", "--repo-root", "{repo_root}", "--bundle", "{input.bundle}", "{input.manual}"], "repeat": [], "capture_stdout": null, "diagnostics_json": true, "failure": "blocked"}
      ]
    },
    "finalize": {
      "allowed_phases": ["validated"],
      "success_phase": "complete",
      "steps": [
        {"argv": ["{python}", "{skill_dir}/scripts/finalize_manual.py", "--repo-root", "{repo_root}", "--bundle", "{input.bundle}", "{input.manual}"], "repeat": [], "capture_stdout": null, "diagnostics_json": false, "failure": "operational"}
      ]
    },
    "audit_report": {
      "allowed_phases": ["auditing"],
      "success_phase": "complete",
      "steps": [
        {"argv": ["{python}", "{skill_dir}/scripts/audit_manual.py", "--repo-root", "{repo_root}", "--bundle", "{input.bundle}", "--glossary", "{input.glossary}", "--profile", "{input.profile}", "{input.manual}"], "repeat": [], "capture_stdout": "audit", "diagnostics_json": false, "failure": "operational"}
      ]
    }
  }
}
