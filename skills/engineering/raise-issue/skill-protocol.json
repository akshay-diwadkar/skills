{
  "protocol_version": "1.0",
  "mode": "stateful",
  "skill": "raise-issue",
  "minimum_python": "3.11",
  "run_dir_policy": "outside_skill_and_repo",
  "requirements": [],
  "inputs": [
    {"name": "handoff", "kind": "path", "required": true, "repeatable": false, "description": "Receipt-sealed audit handoff.", "choices": []},
    {"name": "github_repo_url", "kind": "string", "required": true, "repeatable": false, "description": "Explicit GitHub destination.", "choices": []},
    {"name": "label", "kind": "string", "required": false, "repeatable": true, "description": "Additional label applied to every issue.", "choices": []},
    {"name": "publish_confirmation", "kind": "choice", "required": false, "required_for": ["publish"], "repeatable": false, "description": "Separate confirmation after preview review.", "choices": ["yes"]}
  ],
  "artifacts": [
    {"name": "preview", "path": "preview.json", "media_type": "application/json"},
    {"name": "publication_result", "path": "publication-result.json", "media_type": "application/json"}
  ],
  "phases": {
    "approval-required": {
      "status": "ready",
      "next_action": "Review preview.json and explicitly confirm publication.",
      "next_command": "publish",
      "required_reads": ["{run_dir}/preview.json"],
      "result_artifact": "preview",
      "allowed_writes": [],
      "forbidden_actions": ["publish_issues", "edit_repository", "infer_github_target"]
    },
    "complete": {
      "status": "complete",
      "next_action": null,
      "next_command": null,
      "required_reads": ["{run_dir}/publication-result.json"],
      "result_artifact": "publication_result",
      "allowed_writes": [],
      "forbidden_actions": ["edit_repository", "infer_github_target"]
    }
  },
  "commands": {
    "start": {
      "allowed_phases": ["approval-required"],
      "success_phase": "approval-required",
      "steps": [
        {
          "argv": ["{python}", "{skill_dir}/scripts/publish_github_issues.py", "preview", "--handoff", "{input.handoff}", "--github-repo-url", "{input.github_repo_url}", "--output", "{run_dir}/preview.json"],
          "repeat": [{"input": "label", "flag": "--label"}],
          "capture_stdout": null,
          "diagnostics_json": true,
          "failure": "blocked"
        }
      ]
    },
    "publish": {
      "when": {"publish_confirmation": ["yes"]},
      "allowed_phases": ["approval-required"],
      "success_phase": "complete",
      "steps": [
        {
          "argv": ["{python}", "{skill_dir}/scripts/publish_github_issues.py", "publish", "--handoff", "{input.handoff}", "--github-repo-url", "{input.github_repo_url}", "--preview", "{run_dir}/preview.json", "--publish-confirmation", "{input.publish_confirmation}", "--output", "{run_dir}/publication-result.json"],
          "repeat": [{"input": "label", "flag": "--label"}],
          "capture_stdout": null,
          "diagnostics_json": true,
          "failure": "blocked"
        }
      ]
    }
  }
}
