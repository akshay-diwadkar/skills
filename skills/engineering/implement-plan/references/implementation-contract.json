{
  "contract_version": 4,
  "supported_plan_contract_versions": [6, 7],
  "deprecated_plan_contract_versions": [],
  "supported_tiers": ["tiny", "standard", "high-risk"],
  "statuses": ["in-progress", "complete", "partial", "blocked"],
  "change_kinds": ["planned", "mechanical-propagation"],
  "verification_statuses": ["passed", "failed", "blocked", "skipped"],
  "verification_kinds": ["plan-test", "regression"],
  "quality_classifications": ["pre-existing-failure", "unknown-baseline"],
  "mechanical_propagation": {
    "required_flags": [
      "directly_caused_by_plan",
      "deterministic",
      "no_product_decision",
      "no_new_dependency",
      "no_public_contract_change",
      "no_migration_or_external_effect"
    ],
    "allowed_reasons": ["compile", "type-check", "existing-test-compatibility"]
  },
  "required_bundle_fields": [
    "schema_version", "run_id", "tier", "status", "plan", "workspace", "baseline", "changes",
    "verification", "quality_checks", "warnings", "unresolved_changes", "unresolved_tests",
    "deviations", "final_workspace", "residual_risks", "report"
  ],
  "schemas": {
    "plan": {"required": {"sha256": "string", "normalized": "object"}},
    "workspace": {
      "required": {
        "repository_id": "string", "git_head": "string-or-null", "branch": "string-or-null",
        "targets": "array", "initial_dirty": "object"
      }
    },
    "target": {"required": {"path": "string", "status": "string", "before_sha256": "string"}},
    "baseline": {
      "required": {
        "targets": "array", "dirty": "object", "verification": "array", "quality_checks": "array"
      }
    },
    "change": {
      "required": {
        "kind": "string", "ch_ids": "string-array", "paths": "string-array", "anchors": "string-array",
        "before_sha256": "object", "after_sha256": "object", "evidence": "string-array",
        "verification": "string-array"
      },
      "optional": {"policy_flags": "object", "reason": "string", "unified_diff": "string"}
    },
    "verification": {
      "required": {
        "t_ids": "string-array", "command": "string", "expected": "string", "exit_code": "integer",
        "status": "string", "evidence": "string"
      },
      "optional": {"kind": "string"}
    },
    "quality_check": {
      "required": {
        "tool": "string", "command": "string", "exit_code": "integer", "status": "string",
        "evidence": "string", "paths": "string-array", "file_sha256": "object",
        "checklist_section": "string-array"
      },
      "optional": {"classification": "string"}
    },
    "warning": {
      "required": {"code": "string", "severity": "string", "message": "string"}
    },
    "deviation": {
      "required": {"id": "string", "description": "string", "ch_ids": "string-array", "paths": "string-array", "resolution": "string"}
    },
    "final_workspace": {
      "required": {"git_head": "string-or-null", "status": "object", "changed_paths": "string-array", "dirty": "object"}
    },
    "report": {"required": {"summary": "string"}, "optional": {}}
  },
  "forbidden_automatic_commands": ["git stash", "git checkout --", "git restore", "git reset"]
}
