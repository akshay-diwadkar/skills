{
  "protocol_version": "1.0",
  "skill": "implement-plan",
  "minimum_python": "3.11",
  "run_dir_policy": "outside_skill_and_repo",
  "requirements": [],
  "inputs": [
    {"name": "plan_file", "kind": "path", "required": true, "repeatable": false, "description": "Sealed plan-contract v6 plan.", "choices": []},
    {"name": "bundle", "kind": "path", "path_policy": "future", "required": true, "repeatable": false, "description": "Implementation report bundle.", "choices": []}
  ],
  "artifacts": [],
  "phases": {
    "preflight-ready": {"status": "in_progress", "next_action": "implement_plan", "next_command": "seal", "required_reads": ["{input.plan_file}", "{input.bundle}"], "allowed_writes": ["{repo_root}", "{input.bundle}"], "forbidden_actions": ["overwrite_dirty_target", "edit_unplanned_path"]},
    "complete": {"status": "complete", "next_action": null, "next_command": null, "required_reads": ["{input.bundle}"], "allowed_writes": [], "forbidden_actions": ["modify_finalized_bundle"]}
  },
  "commands": {
    "start": {"allowed_phases": ["preflight-ready"], "success_phase": "preflight-ready", "steps": [{"argv": ["{python}", "{skill_dir}/scripts/prepare_implementation.py", "--repo-root", "{repo_root}", "--plan", "{input.plan_file}", "--output", "{input.bundle}"], "repeat": [], "capture_stdout": null, "diagnostics_json": true, "failure": "blocked"}]},
    "seal": {"allowed_phases": ["preflight-ready"], "success_phase": "complete", "steps": [{"argv": ["{python}", "{skill_dir}/scripts/seal_implementation.py", "--repo-root", "{repo_root}", "--plan", "{input.plan_file}", "--bundle", "{input.bundle}"], "repeat": [], "capture_stdout": null, "diagnostics_json": true, "failure": "blocked"}]}
  }
}
