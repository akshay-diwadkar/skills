{
  "protocol_version": "1.0",
  "mode": "stateless",
  "skill": "plan-change",
  "minimum_python": "3.11",
  "run_dir_policy": "outside_skill_and_repo",
  "requirements": [],
  "inputs": [
    {
      "name": "request_file",
      "kind": "path",
      "required": true,
      "repeatable": false,
      "description": "Existing absolute path to the trusted planning request.",
      "choices": [],
      "path_policy": "existing"
    },
    {
      "name": "draft_file",
      "kind": "path",
      "required": true,
      "repeatable": false,
      "description": "Existing absolute path to the agent-authored v6 draft.",
      "choices": [],
      "path_policy": "existing"
    }
  ],
  "artifacts": [
    {"name": "final", "path": "final.md", "media_type": "text/markdown"}
  ],
  "phases": {},
  "commands": {
    "run": {
      "allowed_phases": [],
      "success_phase": null,
      "steps": [
        {
          "argv": [
            "{python}",
            "{skill_dir}/scripts/seal_plan.py",
            "--repo-root",
            "{repo_root}",
            "--request-file",
            "{input.request_file}",
            "--draft",
            "{input.draft_file}"
          ],
          "repeat": [],
          "capture_stdout": "final",
          "diagnostics_json": true,
          "failure": "blocked"
        }
      ]
    }
  }
}
