{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schema_version", "symbols"],
  "properties": {
    "schema_version": {
      "const": "6.0"
    },
    "symbols": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["file", "line", "kind", "qualified_name", "component_types"],
          "properties": {
            "file": {"type": "string"},
            "line": {"type": "integer", "minimum": 1},
            "kind": {"type": "string"},
            "qualified_name": {"type": "string"},
            "component_types": {
              "type": "array",
              "items": {"type": "string"},
              "uniqueItems": true
            }
          }
        }
      }
    }
  }
}
