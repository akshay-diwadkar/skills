{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schema_version", "symbols"],
  "properties": {
    "schema_version": {
      "const": "5.0"
    },
    "symbols": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["file", "line", "kind"],
          "properties": {
            "file": {"type": "string"},
            "line": {"type": "integer", "minimum": 1},
            "kind": {"type": "string"}
          }
        }
      }
    }
  }
}
