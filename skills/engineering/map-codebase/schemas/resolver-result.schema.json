{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "_meta",
    "task",
    "phase",
    "knowledge_freshness",
    "task_terms",
    "status",
    "primary_owner",
    "co_owners",
    "alternatives",
    "constraints",
    "impacts",
    "confidence",
    "fallback_searches"
  ],
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["command", "schema", "docs"]
    },
    "task": {
      "type": "string"
    },
    "phase": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        {
          "const": "all"
        }
      ]
    },
    "knowledge_freshness": {
      "type": "string"
    },
    "task_terms": {
      "type": "array"
    },
    "confidence": {
      "type": "object"
    },
    "status": {
      "enum": ["resolved", "ambiguous", "abstain"]
    },
    "primary_owner": {
      "type": ["object", "null"]
    },
    "co_owners": {
      "type": "array",
      "maxItems": 2
    },
    "alternatives": {
      "type": "array",
      "maxItems": 2
    },
    "constraints": {
      "type": "array"
    },
    "impacts": {
      "type": "array"
    },
    "targets": {
      "type": "array",
      "maxItems": 3
    },
    "question": {
      "type": "string"
    },
    "stop_condition": {
      "type": "string"
    },
    "expansion_triggers": {
      "type": "array"
    },
    "phases": {
      "type": "array"
    },
    "fallback_searches": {
      "type": "array"
    },
    "tokens_saved_estimate": {
      "type": "object"
    },
    "budget_detail": {
      "type": "object"
    }
  }
}
