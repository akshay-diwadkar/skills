{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schema_version",
    "repository",
    "subsystems",
    "directories",
    "files",
    "entry_points",
    "commands",
    "configurations"
  ],
  "properties": {
    "schema_version": {
      "const": "6.0"
    },
    "repository": {
      "type": "object"
    },
    "subsystems": {
      "type": "array"
    },
    "directories": {
      "type": "array"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "role",
          "subsystem",
          "normalized_subsystem_path",
          "component_types",
          "symbols",
          "calls",
          "generated"
        ],
        "properties": {
          "path": {"type": "string"},
          "role": {"enum": ["source", "test", "configuration"]},
          "subsystem": {"type": "string"},
          "normalized_subsystem_path": {"type": "string"},
          "component_types": {
            "type": "array",
            "items": {"$ref": "#/definitions/componentType"},
            "uniqueItems": true
          },
          "symbols": {"type": "array", "items": {"type": "string"}},
          "calls": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "generated": {"type": "boolean"}
        }
      }
    },
    "entry_points": {
      "type": "array"
    },
    "commands": {
      "type": "array"
    },
    "configurations": {
      "type": "array"
    }
  },
  "definitions": {
    "componentType": {
      "enum": [
        "policy",
        "service",
        "handler",
        "job",
        "repository",
        "adapter",
        "client",
        "model",
        "orchestrator",
        "route/controller",
        "command",
        "migration",
        "schema",
        "documentation",
        "generated",
        "legacy"
      ]
    }
  }
}
