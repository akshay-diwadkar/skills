{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schema_version",
    "shards",
    "symbol_count"
  ],
  "properties": {
    "schema_version": {
      "const": "6.0"
    },
    "shards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "count", "hash"],
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "string"},
          "count": {"type": "integer", "minimum": 0},
          "hash": {"type": "string"}
        }
      }
    },
    "symbol_count": {
      "type": "integer"
    }
  }
}
