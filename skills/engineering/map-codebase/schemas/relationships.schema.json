{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schema_version",
    "imports",
    "calls",
    "test_links",
    "configuration_links",
    "unresolved_imports",
    "reverse_imports"
  ],
  "properties": {
    "schema_version": {
      "const": "6.0"
    },
    "imports": {
      "type": "array"
    },
    "calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "kind", "confidence", "evidence"],
        "properties": {
          "source": {"type": "string"},
          "target": {"type": "string"},
          "kind": {"const": "call"},
          "confidence": {"enum": ["high", "medium", "low"]},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "test_links": {
      "type": "array"
    },
    "configuration_links": {
      "type": "array"
    },
    "unresolved_imports": {
      "type": "array"
    },
    "reverse_imports": {
      "type": "object"
    }
  }
}
