{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akshay-diwadkar/skills/route-engineering-work/routing-decision.schema.json",
  "title": "Engineering routing decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "primary_skill",
    "prerequisites",
    "follow_up",
    "reason",
    "confidence",
    "next_action",
    "allowed_actions",
    "forbidden_actions"
  ],
  "properties": {
    "primary_skill": {
      "oneOf": [
        {
          "$ref": "#/$defs/skill"
        },
        {
          "type": "null"
        }
      ]
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill"
      },
      "uniqueItems": true
    },
    "follow_up": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill"
      },
      "uniqueItems": true
    },
    "reason": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "next_action": {
      "enum": [
        "answer_directly",
        "invoke_prerequisite",
        "invoke_primary_skill"
      ]
    },
    "allowed_actions": {
      "const": [
        "read_request",
        "read_repository_facts",
        "emit_routing_decision"
      ]
    },
    "forbidden_actions": {
      "const": [
        "plan",
        "edit_source",
        "publish_issues",
        "commit",
        "push",
        "create_pull_request",
        "execute_selected_workflow"
      ]
    }
  },
  "$defs": {
    "skill": {
      "enum": [
        "map-codebase",
        "design-codebase",
        "plan-change",
        "implement-plan",
        "audit-codebase",
        "optimize-codebase",
        "scope-issue",
        "diagram-codebase",
        "manualize",
        "raise-issue"
      ]
    }
  }
}
