{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodebaseIndex",
  "type": "object",
  "required": [
    "schema_version",
    "repository",
    "subsystems",
    "files",
    "symbols",
    "entry_points",
    "flows",
    "dependencies",
    "tests",
    "configurations",
    "generated_paths",
    "ignored_paths"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "repository": {
      "type": "object",
      "required": ["root", "revision", "languages", "frameworks"],
      "properties": {
        "root": { "type": "string" },
        "revision": { "type": "string" },
        "languages": { "type": "array", "items": { "type": "string" } },
        "frameworks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "subsystems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "paths"],
        "properties": {
          "name": { "type": "string" },
          "paths": { "type": "array", "items": { "type": "string" } },
          "description": { "type": "string" }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "subsystem", "role", "symbols", "imports", "imported_by", "tests", "keywords", "hash"],
        "properties": {
          "path": { "type": "string" },
          "subsystem": { "type": "string" },
          "role": { "type": "string" },
          "symbols": { "type": "array", "items": { "type": "string" } },
          "imports": { "type": "array", "items": { "type": "string" } },
          "imported_by": { "type": "array", "items": { "type": "string" } },
          "tests": { "type": "array", "items": { "type": "string" } },
          "keywords": { "type": "array", "items": { "type": "string" } },
          "hash": { "type": "string" },
          "role_summary": { "type": "string" }
        }
      }
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "qualified_name", "kind", "path", "line_start", "line_end", "subsystem"],
        "properties": {
          "name": { "type": "string" },
          "qualified_name": { "type": "string" },
          "kind": { "type": "string" },
          "path": { "type": "string" },
          "line_start": { "type": "integer" },
          "line_end": { "type": "integer" },
          "subsystem": { "type": "string" }
        }
      }
    },
    "entry_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "symbol", "kind"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "symbol": { "type": "string" },
          "kind": { "type": "string" }
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "steps"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "type": "string" },
          "steps": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "kind"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "kind": { "type": "string" }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "targets"],
        "properties": {
          "path": { "type": "string" },
          "targets": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "configurations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "role"],
        "properties": {
          "path": { "type": "string" },
          "role": { "type": "string" }
        }
      }
    },
    "generated_paths": { "type": "array", "items": { "type": "string" } },
    "ignored_paths": { "type": "array", "items": { "type": "string" } }
  }
}
