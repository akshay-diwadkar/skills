{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResolverResult",
  "type": "object",
  "required": [
    "task",
    "knowledge",
    "intent",
    "signals",
    "confidence",
    "subsystems",
    "candidates",
    "tests",
    "configuration",
    "recommended_searches",
    "excluded_areas",
    "unknowns",
    "source_validation_required"
  ],
  "properties": {
    "task": { "type": "string" },
    "knowledge": {
      "type": "object",
      "required": ["state", "revision", "warnings"],
      "properties": {
        "state": { "type": "string" },
        "revision": { "type": "string" },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "intent": { "type": "array", "items": { "type": "string" } },
    "signals": {
      "type": "object",
      "required": ["identifiers", "domains", "actions"],
      "properties": {
        "identifiers": { "type": "array", "items": { "type": "string" } },
        "domains": { "type": "array", "items": { "type": "string" } },
        "actions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "confidence": {
      "type": "object",
      "required": ["level", "reasons"],
      "properties": {
        "level": { "type": "string", "enum": ["high", "medium", "low"] },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "subsystems": { "type": "array", "items": { "type": "string" } },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "score", "reasons", "symbols", "read_order"],
        "properties": {
          "path": { "type": "string" },
          "kind": { "type": "string" },
          "score": { "type": "number" },
          "reasons": { "type": "array", "items": { "type": "string" } },
          "symbols": { "type": "array", "items": { "type": "string" } },
          "read_order": { "type": "integer" }
        }
      }
    },
    "tests": { "type": "array", "items": { "type": "string" } },
    "configuration": { "type": "array", "items": { "type": "string" } },
    "recommended_searches": { "type": "array", "items": { "type": "string" } },
    "excluded_areas": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "source_validation_required": { "type": "boolean" }
  }
}
