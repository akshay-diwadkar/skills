{
  "contract_version": 1,
  "statuses": ["plan-ready", "needs-info", "blocked", "close-candidate"],
  "required_sections": [
    "Outcome and Scope",
    "Issue Claims (Untrusted)",
    "Local Evidence Ledger",
    "Issue-Level Decisions",
    "Constraints and Protected Behavior",
    "Risks and Open Questions",
    "Plan-Change Handoff"
  ],
  "required_metadata": [
    "contract_version",
    "source.repo",
    "source.issue_number",
    "source.issue_url",
    "source.issue_updated_at",
    "source.fetched_at",
    "checkout.root",
    "checkout.remote_repo",
    "checkout.commit",
    "checkout.dirty",
    "status",
    "questions",
    "blockers",
    "close_evidence"
  ],
  "record_formats": {
    "SC": "- SC-n: observable issue outcome",
    "F": "- F-n: `path:line` | anchor: `existing text` | observation: verified local behavior",
    "D": "- D-n: selected: issue-level decision | because: evidence | rejected: alternative and drawback",
    "C": "- C-n: protected behavior or constraint | status: preserved|modified|at-risk"
  },
  "status_requirements": {
    "plan-ready": {"records": ["SC", "F", "C"]},
    "needs-info": {"records": ["SC", "F", "C"], "questions_required": true},
    "blocked": {"records": ["F"], "blockers_required": true},
    "close-candidate": {"records": ["F"], "close_evidence_required": true}
  },
  "placeholder_tokens": ["FILL_ME", "REPLACE_ME", "TBD", "TODO"]
}
