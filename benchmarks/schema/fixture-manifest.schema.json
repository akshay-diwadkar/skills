{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "fixture_version",
    "seed",
    "tier",
    "classification",
    "domain",
    "languages",
    "skill_targets",
    "repository",
    "provenance",
    "baseline_conditions",
    "ci",
    "tasks"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "fixture_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "fixture_version": {"type": "integer", "minimum": 1},
    "seed": {"type": "integer", "minimum": 0},
    "tier": {"enum": ["A", "B", "C", "D"]},
    "classification": {
      "enum": [
        "contract-schema",
        "parser",
        "safety-regression",
        "smoke",
        "representative-workflow",
        "scale",
        "comparative-utility"
      ]
    },
    "domain": {"type": "string", "minLength": 1},
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "skill_targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "hash_algorithm",
        "sha256",
        "files",
        "meaningful_files",
        "generator"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "hash_algorithm": {"const": "sha256-path-content-v1"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/fixture_file"}
        },
        "meaningful_files": {"type": "integer", "minimum": 1},
        "generator": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "license"],
      "properties": {
        "kind": {"const": "synthetic"},
        "license": {"type": ["string", "null"]}
      }
    },
    "baseline_conditions": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["resolver-first", "ripgrep", "broad-inventory"]}
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "markers"],
      "properties": {
        "profile": {"enum": ["representative", "full"]},
        "markers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["fixtures", "benchmark", "benchmark_slow"]}
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/task"}
    }
  },
  "definitions": {
    "fixture_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "role": {"enum": ["source", "test", "configuration"]},
        "symbol": {"type": ["string", "null"]},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profile",
        "prompt",
        "aliases",
        "state",
        "expected",
        "required_behaviors",
        "forbidden_behaviors",
        "allowed_alternatives",
        "safety",
        "verification"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "profile": {"enum": ["representative", "full"]},
        "prompt": {"type": "string", "minLength": 12},
        "aliases": {
          "type": "array",
          "items": {"type": "string", "minLength": 12}
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": [
                "clean",
                "ambiguous",
                "stale-index",
                "untracked-owner",
                "dirty-worktree",
                "generated-decoy",
                "prompt-injection",
                "unicode-path"
              ]
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary_owners", "secondary_surfaces", "abstain"],
          "properties": {
            "primary_owners": {"type": "array", "items": {"$ref": "#/definitions/owner"}},
            "secondary_surfaces": {"type": "array", "items": {"$ref": "#/definitions/owner"}},
            "abstain": {"type": "boolean"}
          }
        },
        "required_behaviors": {"type": "array", "items": {"type": "string"}},
        "forbidden_behaviors": {"type": "array", "items": {"type": "string"}},
        "allowed_alternatives": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/definitions/owner"}
          }
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "required": ["protected_paths", "dirty_paths", "external_effects"],
          "properties": {
            "protected_paths": {"type": "array", "items": {"type": "string"}},
            "dirty_paths": {"type": "array", "items": {"type": "string"}},
            "external_effects": {"type": "array", "items": {"type": "string"}}
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commands", "oracles"],
          "properties": {
            "commands": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
            "oracles": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind"],
                "properties": {
                  "kind": {"type": "string"},
                  "path": {"type": "string"},
                  "detail": {"type": "string"}
                }
              }
            }
          }
        },
        "patch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "before", "after"],
          "properties": {
            "path": {"type": "string"},
            "before": {"type": "string"},
            "after": {"type": "string"}
          }
        }
      }
    }
  }
}
